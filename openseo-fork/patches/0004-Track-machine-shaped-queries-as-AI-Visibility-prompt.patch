@@ -51,6 +63,40 @@ export function MachineQueriesSection({
   allImpressions: number;
   truncated: boolean;
 }) {
+  const [selected, setSelected] = useState<Set<string>>(new Set());
+  const selectedQueries = queries.filter((row) => selected.has(row.query));
+
+  const track = useMutation({
+    mutationFn: (rows: QueryRow[]) =>
+      saveAiVisibilityTracker({
+        data: {
+          projectId,
+          // Only formatting is stripped; the wording is what gets tracked.
+          prompts: rows.map((row) => ({
+            text: normalizeMachineQuery(row.query),
+            topic: "From Search Console",
+          })),
+        },
+      }),
+    onSuccess: (result) => {
+      setSelected(new Set());
+      // Duplicates are skipped server-side, so say what actually landed
+      // rather than echoing the number selected.
+      const skipped = result.skipped
+        ? `, ${result.skipped} already tracked`
+        : "";
+      toast.success(`Added ${result.created} prompt(s)${skipped}.`);
+    },
+    onError: (error) => toast.error(getStandardErrorMessage(error)),
+  });
+
+  const toggle = (query: string) =>
+    setSelected((previous) => {
+      const next = new Set(previous);
+      if (next.has(query)) next.delete(query);
+      else next.add(query);
+      return next;
+    });
   const share =
     allImpressions === 0 ? null : matchedImpressions / allImpressions;
   return (
