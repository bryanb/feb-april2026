diff --git a/src/client/features/search-performance/SearchPerformanceTextFilters.tsx b/src/client/features/search-performance/SearchPerformanceTextFilters.tsx
index 6e62d98f..884482db 100644
--- a/src/client/features/search-performance/SearchPerformanceTextFilters.tsx
+++ b/src/client/features/search-performance/SearchPerformanceTextFilters.tsx
@@ -16,7 +16,19 @@ import type { searchPerformanceInputSchema } from "@/types/schemas/search-perfor
 const MATCH_ITEMS = [
   { value: "contains", label: "Contains" },
   { value: "equals", label: "Exactly matches" },
-];
+  { value: "includingRegex", label: "Matches regex" },
+  { value: "excludingRegex", label: "Excludes regex" },
+] as const;
+
+type MatchOperator = (typeof MATCH_ITEMS)[number]["value"];
+
+const isMatchOperator = (value: string): value is MatchOperator =>
+  MATCH_ITEMS.some((item) => item.value === value);
+
+// The Select only ever emits one of its own item values, and null when
+// cleared; the guard keeps the narrowing honest instead of casting.
+const toMatchOperator = (value: string | null): MatchOperator =>
+  value !== null && isMatchOperator(value) ? value : "contains";
 
 export type TextFilters = Pick<
   z.infer<typeof searchPerformanceInputSchema>,
@@ -36,10 +48,10 @@ export function SearchPerformanceTextFilters({
 }) {
   const [page, setPage] = useState(value.pageFilter?.expression ?? "");
   const [query, setQuery] = useState(value.queryFilter?.expression ?? "");
-  const [pageOperator, setPageOperator] = useState<"contains" | "equals">(
+  const [pageOperator, setPageOperator] = useState<MatchOperator>(
     value.pageFilter?.operator ?? "contains",
   );
-  const [queryOperator, setQueryOperator] = useState<"contains" | "equals">(
+  const [queryOperator, setQueryOperator] = useState<MatchOperator>(
     value.queryFilter?.operator ?? "contains",
   );
   const dirtyCount =
@@ -116,7 +128,7 @@ export function SearchPerformanceTextFilters({
               items={MATCH_ITEMS}
               value={pageOperator}
               onValueChange={(operator) =>
-                setPageOperator(operator === "equals" ? "equals" : "contains")
+                setPageOperator(toMatchOperator(operator))
               }
             >
               <SelectTrigger
@@ -153,7 +165,7 @@ export function SearchPerformanceTextFilters({
               items={MATCH_ITEMS}
               value={queryOperator}
               onValueChange={(operator) =>
-                setQueryOperator(operator === "equals" ? "equals" : "contains")
+                setQueryOperator(toMatchOperator(operator))
               }
             >
               <SelectTrigger
diff --git a/src/server/features/gsc/searchAnalytics.test.ts b/src/server/features/gsc/searchAnalytics.test.ts
index 7ca3aef1..4c602b9c 100644
--- a/src/server/features/gsc/searchAnalytics.test.ts
+++ b/src/server/features/gsc/searchAnalytics.test.ts
@@ -64,6 +64,31 @@ describe("resolveDateRange", () => {
 });
 
 describe("buildSearchAnalyticsRequest", () => {
+  it("passes RE2 regex operators through untouched", () => {
+    // Machine-shaped queries (quotes, markdown, search operators) are only
+    // reachable through GSC's regex operators, so the expression must survive
+    // verbatim — escaping or rewriting it would silently change the match.
+    const expression = String.raw`["\u201c\u201d]|\*\*|-site:`;
+    const request = buildSearchAnalyticsRequest(
+      {
+        projectId: "p1",
+        dimensions: ["query"],
+        filters: [
+          { dimension: "query", operator: "includingRegex", expression },
+        ],
+      },
+      TODAY,
+    );
+    expect(request.dimensionFilterGroups).toEqual([
+      {
+        groupType: "and",
+        filters: [
+          { dimension: "query", operator: "includingRegex", expression },
+        ],
+      },
+    ]);
+  });
+
   it("wraps flat filters into a single AND dimensionFilterGroup", () => {
     const request = buildSearchAnalyticsRequest(
       {
