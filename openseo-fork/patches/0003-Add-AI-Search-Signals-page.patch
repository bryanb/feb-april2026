+import { queryOptions } from "@tanstack/react-query";
+import {
+  getAiQuerySignalsReport,
+  getAiReferralReport,
+} from "@/serverFunctions/aiSearchSignals";
+import type {
+  AiSignalsDateRange,
+  aiSignalsPresetSchema,
+} from "@/types/schemas/ai-search-signals";
+import type { z } from "zod";
+
+type PresetId = z.infer<typeof aiSignalsPresetSchema>;
+
+export function aiReferralsQueryOptions(
+  projectId: string,
+  dateRange: AiSignalsDateRange,
+) {
+  return queryOptions({
+    queryKey: ["aiReferrals", projectId, dateRange],
+    queryFn: () => getAiReferralReport({ data: { projectId, dateRange } }),
+  });
+}
+
+export function aiQuerySignalsQueryOptions(
+  projectId: string,
+  dateRange: AiSignalsDateRange,
+  preset: PresetId,
+) {
+  return queryOptions({
+    queryKey: ["aiQuerySignals", projectId, dateRange, preset],
+    queryFn: () =>
+      getAiQuerySignalsReport({ data: { projectId, dateRange, preset } }),
+  });
+}
