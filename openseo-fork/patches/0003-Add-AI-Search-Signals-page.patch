+import {
+  createFileRoute,
+  stripSearchParams,
+  useNavigate,
+} from "@tanstack/react-router";
+import { AiSearchSignalsPage } from "@/client/features/ai-search-signals/AiSearchSignalsPage";
+import { aiSearchSignalsSearchSchema } from "@/types/schemas/ai-search-signals";
+
+export const Route = createFileRoute("/_app/p/$projectId/ai-search-signals")({
+  validateSearch: aiSearchSignalsSearchSchema,
+  search: {
+    middlewares: [stripSearchParams({ range: "last_28_days", preset: "any" })],
+  },
+  component: AiSearchSignalsRoute,
+});
+
+function AiSearchSignalsRoute() {
+  const { projectId } = Route.useParams();
+  const navigate = useNavigate({ from: Route.fullPath });
+  const search = Route.useSearch();
+  return (
+    <AiSearchSignalsPage
+      projectId={projectId}
+      search={search}
+      onSearchChange={(update) => {
+        void navigate({
+          search: (prev) => ({ ...prev, ...update }),
+          replace: true,
+        });
+      }}
+    />
+  );
+}
