@@ -0,0 +1,163 @@
+import { AI_ENGINE_LABELS } from "@/shared/ai-visibility";
+import {
+  AI_REFERRER_ENGINE_LABELS,
+  type AiReferrerEngine,
+} from "@/shared/ai-referrers";
+import {
+  Card,
+  CardContent,
+  CardDescription,
+  CardHeader,
+  CardTitle,
+} from "@/client/components/ui/card";
+import {
+  Table,
+  TableBody,
+  TableCell,
+  TableHead,
+  TableHeader,
+  TableRow,
+} from "@/client/components/ui/table";
+
+const ENGINE_LABELS: Record<AiReferrerEngine, string> = {
+  ...AI_ENGINE_LABELS,
+  ...AI_REFERRER_ENGINE_LABELS,
+};
+
+const integer = new Intl.NumberFormat();
+const percent = new Intl.NumberFormat(undefined, {
+  style: "percent",
+  maximumFractionDigits: 1,
+});
+
+type EngineRow = {
+  engine: AiReferrerEngine;
+  sessions: number;
+  activeUsers: number;
+  engagedSessions: number;
+  keyEvents: number;
+  engagementRate: number | null;
+};
+
+type LandingPageRow = Record<string, string | number | null>;
+
+export function AiReferralsSection({
+  byEngine,
+  landingPages,
+  totalSessions,
+  previousSessions,
+}: {
+  byEngine: EngineRow[];
+  landingPages: LandingPageRow[];
+  totalSessions: number;
+  previousSessions: number;
+}) {
+  const change =
+    previousSessions === 0
+      ? null
+      : (totalSessions - previousSessions) / previousSessions;
+  return (
+    <Card>
+      <CardHeader>
+        <CardTitle>Measured: visits from AI assistants</CardTitle>
+        <CardDescription>
+          Sessions Google Analytics recorded as arriving from an AI assistant.
+          These undercount: assistants that open links without passing a
+          referrer — the ChatGPT apps among them — are counted as Direct and
+          cannot be separated out.
+        </CardDescription>
+      </CardHeader>
+      <CardContent className="space-y-4">
+        <div className="flex flex-wrap gap-6">
+          <div>
+            <div className="text-2xl font-semibold">
+              {integer.format(totalSessions)}
+            </div>
+            <div className="text-sm text-muted-foreground">
+              sessions from AI assistants
+            </div>
+          </div>
+          <div>
+            <div className="text-2xl font-semibold">
+              {change === null ? "—" : percent.format(change)}
+            </div>
+            <div className="text-sm text-muted-foreground">
+              vs previous period
+            </div>
+          </div>
+        </div>
+
+        {byEngine.length === 0 ? (
+          <p className="text-sm text-muted-foreground">
+            No assistant referrals in this period. That is a real zero for
+            referred traffic, but not proof of zero AI visibility — see the
+            Search Console section below.
+          </p>
+        ) : (
+          <Table>
+            <TableHeader>
+              <TableRow>
+                <TableHead>Assistant</TableHead>
+                <TableHead className="text-right">Sessions</TableHead>
+                <TableHead className="text-right">Users</TableHead>
+                <TableHead className="text-right">Engagement</TableHead>
+                <TableHead className="text-right">Key events</TableHead>
+              </TableRow>
+            </TableHeader>
+            <TableBody>
+              {byEngine.map((row) => (
+                <TableRow key={row.engine}>
+                  <TableCell className="font-medium">
+                    {ENGINE_LABELS[row.engine]}
+                  </TableCell>
+                  <TableCell className="text-right">
+                    {integer.format(row.sessions)}
+                  </TableCell>
+                  <TableCell className="text-right">
+                    {integer.format(row.activeUsers)}
+                  </TableCell>
+                  <TableCell className="text-right">
+                    {row.engagementRate === null
+                      ? "—"
+                      : percent.format(row.engagementRate)}
+                  </TableCell>
+                  <TableCell className="text-right">
+                    {integer.format(row.keyEvents)}
+                  </TableCell>
+                </TableRow>
+              ))}
+            </TableBody>
+          </Table>
+        )}
+
+        {landingPages.length > 0 ? (
+          <div className="space-y-2">
+            <h3 className="text-sm font-semibold">
+              Pages assistants send people to
+            </h3>
+            <Table>
+              <TableHeader>
+                <TableRow>
+                  <TableHead>Landing page</TableHead>
+                  <TableHead className="text-right">Sessions</TableHead>
+                </TableRow>
+              </TableHeader>
+              <TableBody>
+                {landingPages.slice(0, 20).map((row, index) => (
+                  <TableRow key={`${row.landingPage}-${index}`}>
+                    <TableCell className="font-mono text-xs">
+                      {String(row.landingPage ?? "")}
+                    </TableCell>
+                    <TableCell className="text-right">
+                      {integer.format(Number(row.sessions ?? 0))}
+                    </TableCell>
+                  </TableRow>
+                ))}
+              </TableBody>
+            </Table>
+          </div>
+        ) : null}
+      </CardContent>
+    </Card>
+  );
+}
