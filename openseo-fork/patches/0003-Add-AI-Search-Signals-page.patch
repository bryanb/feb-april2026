+import { Link } from "@tanstack/react-router";
+import {
+  AI_QUERY_SIGNALS,
+  type AiQueryClassification,
+} from "@/shared/ai-query-signals";
+import { Badge } from "@/client/components/ui/badge";
+import {
+  Card,
+  CardContent,
+  CardDescription,
+  CardHeader,
+  CardTitle,
+} from "@/client/components/ui/card";
+import {
+  Table,
+  TableBody,
+  TableCell,
+  TableHead,
+  TableHeader,
+  TableRow,
+} from "@/client/components/ui/table";
+
+const integer = new Intl.NumberFormat();
+const percent = new Intl.NumberFormat(undefined, {
+  style: "percent",
+  maximumFractionDigits: 1,
+});
+
+const signalLabel = (id: string) =>
+  AI_QUERY_SIGNALS.find((signal) => signal.id === id)?.label ?? id;
+
+type QueryRow = AiQueryClassification & {
+  query: string;
+  clicks: number;
+  impressions: number;
+  position: number | null;
+};
+
+export function MachineQueriesSection({
+  projectId,
+  queries,
+  expression,
+  matchedImpressions,
+  allImpressions,
+  truncated,
+}: {
+  projectId: string;
+  queries: QueryRow[];
+  expression: string;
+  matchedImpressions: number;
+  allImpressions: number;
+  truncated: boolean;
+}) {
+  const share =
+    allImpressions === 0 ? null : matchedImpressions / allImpressions;
+  return (
+    <Card>
+      <CardHeader>
+        <CardTitle>Inferred: machine-shaped Search Console queries</CardTitle>
+        <CardDescription>
+          Google does not label AI traffic, so these are queries whose text
+          carries syntax people rarely type: exact-match quotes, markdown, and
+          search operators. Treat the counts as a lower bound on assistant
+          activity, not a measurement of it.
+        </CardDescription>
+      </CardHeader>
+      <CardContent className="space-y-4">
+        <div className="flex flex-wrap gap-6">
+          <div>
+            <div className="text-2xl font-semibold">
+              {integer.format(matchedImpressions)}
+            </div>
+            <div className="text-sm text-muted-foreground">
+              impressions on matching queries
+            </div>
+          </div>
+          <div>
+            <div className="text-2xl font-semibold">
+              {share === null ? "—" : percent.format(share)}
+            </div>
+            <div className="text-sm text-muted-foreground">
+              of all impressions
+            </div>
+          </div>
+          <div>
+            <div className="text-2xl font-semibold">
+              {integer.format(queries.length)}
+              {truncated ? "+" : ""}
+            </div>
+            <div className="text-sm text-muted-foreground">
+              distinct queries
+            </div>
+          </div>
+        </div>
+
+        {queries.length === 0 ? (
+          <p className="text-sm text-muted-foreground">
+            No queries matched these patterns in this period.
+          </p>
+        ) : (
+          <Table>
+            <TableHeader>
+              <TableRow>
+                <TableHead>Query</TableHead>
+                <TableHead>Signals</TableHead>
+                <TableHead className="text-right">Clicks</TableHead>
+                <TableHead className="text-right">Impressions</TableHead>
+                <TableHead className="text-right">Position</TableHead>
+                <TableHead className="text-right">Words</TableHead>
+              </TableRow>
+            </TableHeader>
+            <TableBody>
+              {queries.slice(0, 100).map((row) => (
+                <TableRow key={row.query}>
+                  <TableCell className="max-w-md break-words font-mono text-xs">
+                    {row.query}
+                  </TableCell>
+                  <TableCell className="space-x-1">
+                    {row.signalIds.map((id) => (
+                      <Badge
+                        key={id}
+                        variant={
+                          row.verdict === "likely_machine"
+                            ? "secondary"
+                            : "outline"
+                        }
+                      >
+                        {signalLabel(id)}
+                      </Badge>
+                    ))}
+                  </TableCell>
+                  <TableCell className="text-right">
+                    {integer.format(row.clicks)}
+                  </TableCell>
+                  <TableCell className="text-right">
+                    {integer.format(row.impressions)}
+                  </TableCell>
+                  <TableCell className="text-right">
+                    {row.position === null ? "—" : row.position.toFixed(1)}
+                  </TableCell>
+                  <TableCell className="text-right text-muted-foreground">
+                    {row.wordCount}
+                  </TableCell>
+                </TableRow>
+              ))}
+            </TableBody>
+          </Table>
+        )}
+
+        <div className="space-y-1 text-xs text-muted-foreground">
+          <p>
+            Pattern used:{" "}
+            <code className="break-all font-mono">{expression}</code>
+          </p>
+          <Link
+            to="/p/$projectId/search-performance"
+            params={{ projectId }}
+            search={{ queryText: expression, queryMatch: "includingRegex" }}
+            className="font-medium underline-offset-4 hover:text-foreground hover:underline"
+          >
+            Open these queries in Search Performance
+          </Link>
+        </div>
+      </CardContent>
+    </Card>
+  );
+}
