@@ -0,0 +1,34 @@
+import { z } from "zod";
+import { AI_QUERY_PRESET_IDS } from "@/shared/ai-query-signals";
+
+/**
+ * Ranges for the AI Search Signals page. Matches the Search Performance page's
+ * subset so the two read the same; assignability to GscDateRange is
+ * compiler-checked at the resolveDateRange call site.
+ */
+export const AI_SIGNALS_RANGES = [
+  "last_7_days",
+  "last_28_days",
+  "last_3_months",
+] as const;
+
+export type AiSignalsDateRange = (typeof AI_SIGNALS_RANGES)[number];
+
+export const aiSignalsPresetSchema = z.enum(AI_QUERY_PRESET_IDS);
+
+export const aiSearchSignalsInputSchema = z.object({
+  projectId: z.string().min(1),
+  dateRange: z.enum(AI_SIGNALS_RANGES).default("last_28_days"),
+  preset: aiSignalsPresetSchema.default("any"),
+});
+
+export const aiReferralsInputSchema = z.object({
+  projectId: z.string().min(1),
+  dateRange: z.enum(AI_SIGNALS_RANGES).default("last_28_days"),
+});
+
+/** /p/$projectId/ai-search-signals query params. */
+export const aiSearchSignalsSearchSchema = z.object({
+  range: z.enum(AI_SIGNALS_RANGES).optional().catch(undefined),
+  preset: aiSignalsPresetSchema.optional().catch(undefined),
+});
