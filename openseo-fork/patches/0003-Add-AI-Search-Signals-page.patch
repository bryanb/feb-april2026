+import { useQuery } from "@tanstack/react-query";
+import { QueryError } from "@/client/components/QueryState";
+import { Spinner } from "@/client/components/ui/spinner";
+import {
+  Select,
+  SelectContent,
+  SelectItem,
+  SelectTrigger,
+  SelectValue,
+} from "@/client/components/ui/select";
+import { GoogleConnectionCard } from "@/client/features/integrations/GoogleConnectionCard";
+import { AiReferralsSection } from "./AiReferralsSection";
+import { MachineQueriesSection } from "./MachineQueriesSection";
+import {
+  aiQuerySignalsQueryOptions,
+  aiReferralsQueryOptions,
+} from "./aiSearchSignalsQueries";
+import type {
+  AiSignalsDateRange,
+  aiSearchSignalsSearchSchema,
+} from "@/types/schemas/ai-search-signals";
+import type { z } from "zod";
+
+type Search = z.infer<typeof aiSearchSignalsSearchSchema>;
+
+const RANGE_ITEMS = [
+  { value: "last_7_days", label: "Last 7 days" },
+  { value: "last_28_days", label: "Last 28 days" },
+  { value: "last_3_months", label: "Last 3 months" },
+] as const;
+
+const isRange = (value: string | null): value is AiSignalsDateRange =>
+  RANGE_ITEMS.some((item) => item.value === value);
+
+export function AiSearchSignalsPage({
+  projectId,
+  search,
+  onSearchChange,
+}: {
+  projectId: string;
+  search: Search;
+  onSearchChange: (update: Partial<Search>) => void;
+}) {
+  const range = search.range ?? "last_28_days";
+  const preset = search.preset ?? "any";
+
+  const referralsQuery = useQuery(aiReferralsQueryOptions(projectId, range));
+  const signalsQuery = useQuery(
+    aiQuerySignalsQueryOptions(projectId, range, preset),
+  );
+
+  const referrals = referralsQuery.data;
+  const signals = signalsQuery.data;
+
+  return (
+    <div className="overflow-auto px-4 py-4 pb-24 md:px-6 md:py-6 md:pb-8">
+      <div className="mx-auto max-w-7xl space-y-4">
+        <div className="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
+          <div>
+            <h1 className="text-2xl font-semibold">AI Search Signals</h1>
+            <p className="text-sm text-muted-foreground">
+              Where this site shows up in AI-driven search — what Analytics
+              measured, and what Search Console suggests.
+            </p>
+          </div>
+          <Select
+            items={RANGE_ITEMS}
+            value={range}
+            onValueChange={(value) =>
+              onSearchChange({ range: isRange(value) ? value : undefined })
+            }
+          >
+            <SelectTrigger
+              size="sm"
+              className="w-full sm:w-44 sm:shrink-0"
+              aria-label="Date range"
+            >
+              <SelectValue />
+            </SelectTrigger>
+            <SelectContent>
+              {RANGE_ITEMS.map((item) => (
+                <SelectItem key={item.value} value={item.value}>
+                  {item.label}
+                </SelectItem>
+              ))}
+            </SelectContent>
+          </Select>
+        </div>
+
+        {referralsQuery.isPending ? (
+          <Spinner />
+        ) : referralsQuery.isError ? (
+          <QueryError
+            title="Could not load AI referrals"
+            fallback="Google Analytics did not return the report."
+            error={referralsQuery.error}
+            onRetry={() => void referralsQuery.refetch()}
+          />
+        ) : !referrals?.connected ? (
+          <div className="max-w-2xl">
+            <GoogleConnectionCard provider="ga4" projectId={projectId} />
+          </div>
+        ) : referrals.report ? (
+          <AiReferralsSection
+            byEngine={referrals.report.byEngine}
+            landingPages={referrals.report.landingPages}
+            totalSessions={referrals.report.totals.sessions}
+            previousSessions={referrals.report.totals.previousSessions}
+          />
+        ) : null}
+
+        {signalsQuery.isPending ? (
+          <Spinner />
+        ) : signalsQuery.isError ? (
+          <QueryError
+            title="Could not load Search Console queries"
+            fallback="Search Console did not return the report."
+            error={signalsQuery.error}
+            onRetry={() => void signalsQuery.refetch()}
+          />
+        ) : !signals?.connected ? (
+          <div className="max-w-2xl">
+            <GoogleConnectionCard provider="gsc" projectId={projectId} />
+          </div>
+        ) : (
+          <MachineQueriesSection
+            projectId={projectId}
+            queries={signals.queries}
+            expression={signals.expression}
+            matchedImpressions={signals.totals.matchedImpressions}
+            allImpressions={signals.totals.allImpressions}
+            truncated={signals.truncated}
+          />
+        )}
+      </div>
+    </div>
+  );
+}
