--- /dev/null
+++ b/src/serverFunctions/aiSearchSignals.ts
@@ -0,0 +1,174 @@
+import { createServerFn } from "@tanstack/react-start";
+import { Ga4AiReferralService } from "@/server/features/ga4/services/Ga4AiReferralService";
+import { Ga4ReportError } from "@/server/lib/ga4Errors";
+import {
+  GscNotConnectedError,
+  GscService,
+  isExpectedGrantFailure,
+} from "@/server/features/gsc/services/GscService";
+import { resolveDateRange } from "@/server/features/gsc/searchAnalytics";
+import { previousPeriod } from "@/server/features/gsc/searchPerformanceReport";
+import { requireProjectContext } from "@/serverFunctions/middleware";
+import { AI_QUERY_PRESETS, classifyQuery } from "@/shared/ai-query-signals";
+import {
+  aiReferralsInputSchema,
+  aiSearchSignalsInputSchema,
+} from "@/types/schemas/ai-search-signals";
+
+/** dimensions:["date"] returns one row per day; the longest range is ~92 days. */
+const DAILY_ROW_LIMIT = 200;
+/**
+ * Matching queries are a small fraction of a property's rows and Google
+ * filters them server-side, so this ceiling is about keeping one response
+ * readable rather than about the property's size.
+ */
+const MATCHED_QUERY_LIMIT = 500;
+
+/** Not connected, or a dead/denied grant: the page renders the connect card.
+ *  Other statuses (429, 5xx) are real faults. */
+function isExpectedConnectionFailure(error: unknown): boolean {
+  return error instanceof GscNotConnectedError || isExpectedGrantFailure(error);
+}
+
+const sumMetric = (
+  rows: { clicks?: number; impressions?: number }[],
+  key: "clicks" | "impressions",
+) => rows.reduce((total, row) => total + (row[key] ?? 0), 0);
+
+/**
+ * Search Console queries whose text looks machine-issued, with the share of
+ * impressions and clicks they account for.
+ *
+ * Google labels none of this. The regex runs at Google so only matching rows
+ * come back, and the same patterns re-run locally to say which fingerprint
+ * each row tripped. Every number here is a lower bound on assistant activity,
+ * never a measurement of it.
+ */
+export const getAiQuerySignalsReport = createServerFn({ method: "POST" })
+  .middleware(requireProjectContext)
+  .validator(aiSearchSignalsInputSchema)
+  .handler(async ({ data, context }) => {
+    const { startDate, endDate } = resolveDateRange({
+      dateRange: data.dateRange,
+    });
+    const prev = previousPeriod(startDate, endDate);
+    const projectId = context.projectId;
+    const expression = AI_QUERY_PRESETS[data.preset];
+    const matchFilter = [
+      {
+        dimension: "query" as const,
+        operator: "includingRegex" as const,
+        expression,
+      },
+    ];
+
+    try {
+      const [allDays, matchedDays, matchedPrevDays, matchedQueries] =
+        await Promise.all([
+          GscService.getPerformance({
+            projectId,
+            startDate,
+            endDate,
+            dimensions: ["date"],
+            rowLimit: DAILY_ROW_LIMIT,
+          }),
+          GscService.getPerformance({
+            projectId,
+            startDate,
+            endDate,
+            dimensions: ["date"],
+            filters: matchFilter,
+            rowLimit: DAILY_ROW_LIMIT,
+          }),
+          GscService.getPerformance({
+            projectId,
+            startDate: prev.startDate,
+            endDate: prev.endDate,
+            dimensions: ["date"],
+            filters: matchFilter,
+            rowLimit: DAILY_ROW_LIMIT,
+          }),
+          GscService.getPerformance({
+            projectId,
+            startDate,
+            endDate,
+            dimensions: ["query"],
+            filters: matchFilter,
+            rowLimit: MATCHED_QUERY_LIMIT,
+          }),
+        ]);
+
+      const queries = matchedQueries.rows.map((row) => {
+        const query = String(row.keys?.[0] ?? "");
+        return {
+          query,
+          clicks: row.clicks ?? 0,
+          impressions: row.impressions ?? 0,
+          position: row.position ?? null,
+          ...classifyQuery(query),
+        };
+      });
+
+      return {
+        connected: true as const,
+        range: { startDate, endDate },
+        preset: data.preset,
+        /** Shown in the UI so the inference is auditable, not a black box. */
+        expression,
+        totals: {
+          matchedClicks: sumMetric(matchedDays.rows, "clicks"),
+          matchedImpressions: sumMetric(matchedDays.rows, "impressions"),
+          allClicks: sumMetric(allDays.rows, "clicks"),
+          allImpressions: sumMetric(allDays.rows, "impressions"),
+          previousMatchedImpressions: sumMetric(
+            matchedPrevDays.rows,
+            "impressions",
+          ),
+        },
+        trend: matchedDays.rows.map((row) => ({
+          date: String(row.keys?.[0] ?? ""),
+          clicks: row.clicks ?? 0,
+          impressions: row.impressions ?? 0,
+        })),
+        queries,
+        truncated: queries.length >= MATCHED_QUERY_LIMIT,
+      };
+    } catch (error) {
+      if (isExpectedConnectionFailure(error)) {
+        return { connected: false as const };
+      }
+      throw error;
+    }
+  });
+
+/**
+ * Sessions GA4 recorded as arriving from an AI assistant. Measured, unlike the
+ * query report above — though it undercounts, because assistants that strip
+ * the referrer are indistinguishable from Direct.
+ */
+export const getAiReferralReport = createServerFn({ method: "POST" })
+  .middleware(requireProjectContext)
+  .validator(aiReferralsInputSchema)
+  .handler(async ({ data, context }) => {
+    const { startDate, endDate } = resolveDateRange({
+      dateRange: data.dateRange,
+    });
+    try {
+      const report = await Ga4AiReferralService.getAiReferrals({
+        projectId: context.projectId,
+        startDate,
+        endDate,
+      });
+      return { connected: true as const, report };
+    } catch (error) {
+      if (
+        error instanceof Ga4ReportError &&
+        (error.code === "ga4_not_connected" ||
+          error.code === "ga4_reconnect_required" ||
+          error.code === "ga4_property_inaccessible")
+      ) {
+        return { connected: false as const };
+      }
+      throw error;
+    }
+  });
