@@ -0,0 +1,196 @@
+import { useState } from "react";
+import { useMutation } from "@tanstack/react-query";
+import { Loader2, Radar } from "lucide-react";
+import { toast } from "sonner";
+import {
+  parseBingAiPerformance,
+  type BingGroundingQuery,
+} from "@/shared/bing-ai-performance";
+import { Badge } from "@/client/components/ui/badge";
+import { Button } from "@/client/components/ui/button";
+import { Checkbox } from "@/client/components/ui/checkbox";
+import { Textarea } from "@/client/components/ui/textarea";
+import {
+  Card,
+  CardContent,
+  CardDescription,
+  CardHeader,
+  CardTitle,
+} from "@/client/components/ui/card";
+import {
+  Table,
+  TableBody,
+  TableCell,
+  TableHead,
+  TableHeader,
+  TableRow,
+} from "@/client/components/ui/table";
+import {
+  TableBulkActionBar,
+  TableBulkActionButton,
+} from "@/client/components/table/TableBulkActionBar";
+import { getStandardErrorMessage } from "@/client/lib/error-messages";
+import { saveAiVisibilityTracker } from "@/serverFunctions/ai-visibility";
+
+const integer = new Intl.NumberFormat();
+const percent = new Intl.NumberFormat(undefined, {
+  style: "percent",
+  maximumFractionDigits: 1,
+});
+
+export function BingImportSection({ projectId }: { projectId: string }) {
+  const [raw, setRaw] = useState("");
+  const [queries, setQueries] = useState<BingGroundingQuery[]>([]);
+  const [selected, setSelected] = useState<Set<string>>(new Set());
+  const selectedQueries = queries.filter((row) => selected.has(row.query));
+
+  const load = () => {
+    const result = parseBingAiPerformance(raw);
+    if (!result.ok) {
+      toast.error(result.error);
+      return;
+    }
+    if (result.value.queries.length === 0) {
+      toast.error(
+        "That export has cited pages but no grounding queries. Paste the grounding-queries response to pick prompts.",
+      );
+      return;
+    }
+    setQueries(result.value.queries);
+    setSelected(new Set());
+    const total = result.value.reportedQueryTotal;
+    const partial =
+      total && total > result.value.queries.length
+        ? ` Bing reports ${total} in total, so this paste is partial.`
+        : "";
+    toast.success(
+      `Loaded ${result.value.queries.length} grounding queries.${partial}`,
+    );
+  };
+
+  const track = useMutation({
+    mutationFn: (rows: BingGroundingQuery[]) =>
+      saveAiVisibilityTracker({
+        data: {
+          projectId,
+          prompts: rows.map((row) => ({
+            text: row.query,
+            topic: "From Bing AI",
+          })),
+        },
+      }),
+    onSuccess: (result) => {
+      setSelected(new Set());
+      const skipped = result.skipped
+        ? `, ${result.skipped} already tracked`
+        : "";
+      toast.success(`Added ${result.created} prompt(s)${skipped}.`);
+    },
+    onError: (error) => toast.error(getStandardErrorMessage(error)),
+  });
+
+  const toggle = (query: string) =>
+    setSelected((previous) => {
+      const next = new Set(previous);
+      if (next.has(query)) next.delete(query);
+      else next.add(query);
+      return next;
+    });
+
+  return (
+    <Card>
+      <CardHeader>
+        <CardTitle>Measured: grounding queries from Bing</CardTitle>
+        <CardDescription>
+          The phrases an AI actually used when it retrieved and cited your pages
+          — the closest thing to ground truth available anywhere. Bing exposes
+          this in its web app only, with no API, so paste the export here. These
+          make better tracked prompts than anything inferred from Search
+          Console.
+        </CardDescription>
+      </CardHeader>
+      <CardContent className="space-y-4">
+        <div className="space-y-2">
+          <Textarea
+            value={raw}
+            onChange={(event) => setRaw(event.target.value)}
+            placeholder={`Paste the Bing AI Performance export for this site — either the CSV download or the JSON response, e.g. {"Queries":[...]}`}
+            className="h-28 font-mono text-xs"
+            aria-label="Bing AI Performance export (CSV or JSON)"
+          />
+          <Button size="sm" onClick={load} disabled={!raw.trim()}>
+            Load export
+          </Button>
+        </div>
+
+        {queries.length > 0 ? (
+          <Table>
+            <TableHeader>
+              <TableRow>
+                <TableHead className="w-8" />
+                <TableHead>Grounding query</TableHead>
+                <TableHead>Intent</TableHead>
+                <TableHead className="text-right">Citations</TableHead>
+                <TableHead className="text-right">Citation rate</TableHead>
+              </TableRow>
+            </TableHeader>
+            <TableBody>
+              {queries.map((row) => (
+                <TableRow key={row.query}>
+                  <TableCell>
+                    <Checkbox
+                      checked={selected.has(row.query)}
+                      onCheckedChange={() => toggle(row.query)}
+                      aria-label={`Track ${row.query}`}
+                    />
+                  </TableCell>
+                  <TableCell className="max-w-md break-words">
+                    {row.query}
+                  </TableCell>
+                  <TableCell className="space-x-1">
+                    {row.intents.map((intent) => (
+                      <Badge key={intent} variant="outline">
+                        {intent}
+                      </Badge>
+                    ))}
+                  </TableCell>
+                  <TableCell className="text-right">
+                    {integer.format(row.citations)}
+                  </TableCell>
+                  <TableCell className="text-right">
+                    {row.citationRate === null
+                      ? "—"
+                      : percent.format(row.citationRate)}
+                  </TableCell>
+                </TableRow>
+              ))}
+            </TableBody>
+          </Table>
+        ) : null}
+
+        <TableBulkActionBar
+          selectedCount={selectedQueries.length}
+          selectedLabel={selectedQueries.length === 1 ? "query" : "queries"}
+          onClear={() => setSelected(new Set())}
+          actions={
+            <div className="flex items-center gap-1 px-1.5">
+              <TableBulkActionButton
+                icon={
+                  track.isPending ? (
+                    <Loader2 className="size-3.5 animate-spin" />
+                  ) : (
+                    <Radar className="size-3.5" />
+                  )
+                }
+                onClick={() => track.mutate(selectedQueries)}
+                disabled={track.isPending}
+              >
+                Track as prompts
+              </TableBulkActionButton>
+            </div>
+          }
+        />
+      </CardContent>
+    </Card>
+  );
+}
diff --git a/src/shared/bing-ai-performance.test.ts b/src/shared/bing-ai-performance.test.ts
new file mode 100644
