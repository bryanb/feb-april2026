--- /dev/null
+++ b/src/shared/bing-ai-performance.test.ts
@@ -0,0 +1,88 @@
+import { describe, expect, it } from "vitest";
+import { parseBingAiPerformance } from "@/shared/bing-ai-performance";
+
+// Trimmed from a real grounding-queries response.
+const queriesResponse = JSON.stringify({
+  Queries: [
+    {
+      GroundingQuery: "can to ethernet converter",
+      Intent: ["Commercial"],
+      Citations: 580,
+      TopicClusters: ["Cables & Adapters"],
+      Topics: [],
+      CitationRate: 0.3806,
+    },
+  ],
+  TotalNumOfRecords: 36,
+  SiteUrl: "https://www.axiomatic.com/",
+});
+
+describe("parseBingAiPerformance", () => {
+  it("reads a grounding-queries response", () => {
+    const result = parseBingAiPerformance(queriesResponse);
+    expect(result).toEqual({
+      ok: true,
+      value: {
+        siteUrl: "https://www.axiomatic.com/",
+        queries: [
+          {
+            query: "can to ethernet converter",
+            citations: 580,
+            citationRate: 0.3806,
+            intents: ["Commercial"],
+            topics: ["Cables & Adapters"],
+          },
+        ],
+        pages: [],
+        reportedQueryTotal: 36,
+      },
+    });
+  });
+
+  it("reads a pages response", () => {
+    const result = parseBingAiPerformance(
+      JSON.stringify({
+        Pages: [{ PageUrl: "https://www.axiomatic.com/", Citations: 1346 }],
+        TotalNumOfRecords: 314,
+      }),
+    );
+    expect(result.ok && result.value.pages).toEqual([
+      { url: "https://www.axiomatic.com/", citations: 1346 },
+    ]);
+  });
+
+  it("keeps a missing citation rate distinguishable from zero", () => {
+    // A rate Bing omitted must not render as 0%, which would read as
+    // "never cited" for a phrase that is in fact cited.
+    const result = parseBingAiPerformance(
+      JSON.stringify({ Queries: [{ GroundingQuery: "x", Citations: 5 }] }),
+    );
+    expect(result.ok && result.value.queries[0]?.citationRate).toBeNull();
+  });
+
+  it("reads the UI's CSV export, whose headings differ from the JSON fields", () => {
+    // The CSV says "Grounding query" and "Citation share"; the JSON says
+    // GroundingQuery and CitationRate. Matching on exact text would silently
+    // drop every column from the download route.
+    const csv = [
+      "Grounding query,Intent,Topic,Citations,Citation share",
+      '"can to ethernet converter",Commercial,"Cables & Adapters",580,38.06%',
+    ].join("\n");
+    const result = parseBingAiPerformance(csv);
+    const row = result.ok ? result.value.queries[0] : null;
+    expect(row).toMatchObject({
+      query: "can to ethernet converter",
+      citations: 580,
+      intents: ["Commercial"],
+      topics: ["Cables & Adapters"],
+    });
+    // Percent-to-fraction division is lossy; Bing's own JSON reports this
+    // same value as 0.38060000000000005.
+    expect(row?.citationRate).toBeCloseTo(0.3806, 6);
+  });
+
+  it("explains an unrecognized paste instead of throwing", () => {
+    expect(parseBingAiPerformance("{}")).toMatchObject({ ok: false });
+    expect(parseBingAiPerformance("not json")).toMatchObject({ ok: false });
+  });
+});
diff --git a/src/shared/bing-ai-performance.ts b/src/shared/bing-ai-performance.ts
new file mode 100644
index 00000000..7b5f8e0b
--- /dev/null
+++ b/src/shared/bing-ai-performance.ts
@@ -0,0 +1,241 @@
+/**
+ * Parses a Bing Webmaster Tools "AI Performance" export.
+ *
+ * Grounding queries are the phrases an AI actually used when it retrieved and
+ * cited a page — the only first-party record of that anywhere. Bing exposes
+ * them in its web app only: the published Webmaster API has no method for
+ * them, and the app's own endpoint rides a session cookie and CSRF token, so
+ * the app cannot fetch this itself. The owner exports it from their browser
+ * and pastes it here.
+ *
+ * Two shapes are accepted, because both are things a person will realistically
+ * paste: a single raw response from one of Bing's endpoints, or an object
+ * combining the queries and pages responses.
+ */
+
+import Papa from "papaparse";
+import { z } from "zod";
+
+const groundingQueryRow = z
+  .object({
+    GroundingQuery: z.string().min(1),
+    Citations: z.number().nonnegative(),
+    /** Share of retrievals for this phrase that cited the site, 0-1. */
+    CitationRate: z.number().optional(),
+    Intent: z.array(z.string()).optional(),
+    TopicClusters: z.array(z.string()).optional(),
+  })
+  .passthrough();
+
+const citedPageRow = z
+  .object({
+    PageUrl: z.string().min(1),
+    Citations: z.number().nonnegative(),
+  })
+  .passthrough();
+
+/** Both endpoints wrap their rows and report a total beyond the page fetched. */
+const queriesResponse = z.object({
+  Queries: z.array(groundingQueryRow),
+  TotalNumOfRecords: z.number().optional(),
+  SiteUrl: z.string().optional(),
+});
+
+const pagesResponse = z.object({
+  Pages: z.array(citedPageRow),
+  TotalNumOfRecords: z.number().optional(),
+  SiteUrl: z.string().optional(),
+});
+
+const combinedExport = z.object({
+  site: z.string().optional(),
+  queries: z.array(groundingQueryRow).optional(),
+  pages: z.array(citedPageRow).optional(),
+});
+
+export interface BingGroundingQuery {
+  query: string;
+  citations: number;
+  /** Null when Bing omitted it, so the UI can show "—" rather than 0%. */
+  citationRate: number | null;
+  intents: string[];
+  topics: string[];
+}
+
+interface BingCitedPage {
+  url: string;
+  citations: number;
+}
+
+interface BingAiPerformanceImport {
+  siteUrl: string | null;
+  queries: BingGroundingQuery[];
+  pages: BingCitedPage[];
+  /** Bing's own total, when present, so a partial paste is visible as partial. */
+  reportedQueryTotal: number | null;
+}
+
+const toQuery = (
+  row: z.infer<typeof groundingQueryRow>,
+): BingGroundingQuery => ({
+  query: row.GroundingQuery,
+  citations: row.Citations,
+  citationRate: row.CitationRate ?? null,
+  intents: row.Intent ?? [],
+  topics: row.TopicClusters ?? [],
+});
+
+const toPage = (row: z.infer<typeof citedPageRow>): BingCitedPage => ({
+  url: row.PageUrl,
+  citations: row.Citations,
+});
+
+/**
+ * Bing's UI export uses display headings ("Grounding query", "Citation
+ * share"), not the JSON payload's field names, so columns are matched by a
+ * normalized form of the heading rather than exact text.
+ */
+const CSV_COLUMNS = {
+  query: ["groundingquery", "query"],
+  citations: ["citations"],
+  citationRate: ["citationshare", "citationrate"],
+  intent: ["intent"],
+  topic: ["topic", "topics", "topicclusters"],
+} as const;
+
+const normalizeHeading = (heading: string) =>
+  heading.toLowerCase().replace(/[^a-z]/g, "");
+
+function columnFinder(headings: string[]) {
+  const normalized = headings.map(normalizeHeading);
+  return (candidates: readonly string[]) => {
+    const index = normalized.findIndex((heading) =>
+      candidates.includes(heading),
+    );
+    return index === -1 ? null : headings[index];
+  };
+}
+
+/** Accepts "38.06%", "38.06" and "0.3806", all of which Bing has used. */
+function parseRate(value: string | undefined): number | null {
+  if (!value) return null;
+  const trimmed = value.trim();
+  if (trimmed === "") return null;
+  const numeric = Number.parseFloat(trimmed.replace(/[%\s]/g, ""));
+  if (!Number.isFinite(numeric)) return null;
+  return trimmed.includes("%") || numeric > 1 ? numeric / 100 : numeric;
+}
+
+const splitList = (value: string | undefined) =>
+  (value ?? "")
+    .split(/[;,|]/)
+    .map((part) => part.trim())
+    .filter(Boolean);
+
+function parseCsv(raw: string): BingAiPerformanceImport | null {
+  const parsed = Papa.parse<Record<string, string>>(raw.trim(), {
+    header: true,
+    skipEmptyLines: true,
+  });
+  const headings = parsed.meta.fields ?? [];
+  const find = columnFinder(headings);
+  const queryColumn = find(CSV_COLUMNS.query);
+  if (!queryColumn) return null;
+
+  const citationsColumn = find(CSV_COLUMNS.citations);
+  const rateColumn = find(CSV_COLUMNS.citationRate);
+  const intentColumn = find(CSV_COLUMNS.intent);
+  const topicColumn = find(CSV_COLUMNS.topic);
+
+  const queries = parsed.data
+    .map((row) => ({
+      query: (row[queryColumn] ?? "").trim(),
+      citations: Number.parseInt(
+        (citationsColumn ? (row[citationsColumn] ?? "0") : "0").replace(
+          /[^0-9-]/g,
+          "",
+        ),
+        10,
+      ),
+      citationRate: rateColumn ? parseRate(row[rateColumn]) : null,
+      intents: intentColumn ? splitList(row[intentColumn]) : [],
+      topics: topicColumn ? splitList(row[topicColumn]) : [],
+    }))
+    .filter((row) => row.query !== "")
+    .map((row) => ({
+      ...row,
+      citations: Number.isFinite(row.citations) ? row.citations : 0,
+    }));
+
+  return queries.length === 0
+    ? null
+    : { siteUrl: null, queries, pages: [], reportedQueryTotal: null };
+}
+
+/**
+ * Returns the parsed export, or a message naming what was wrong. Pasting the
+ * wrong thing is the normal failure here, so it is an expected result rather
+ * than a thrown error.
+ */
+export function parseBingAiPerformance(
+  raw: string,
+): { ok: true; value: BingAiPerformanceImport } | { ok: false; error: string } {
+  let json: unknown;
+  try {
+    json = JSON.parse(raw);
+  } catch {
+    const csv = parseCsv(raw);
+    return csv
+      ? { ok: true, value: csv }
+      : {
+          ok: false,
+          error:
+            "Could not read that as Bing JSON or as a CSV export with a grounding-query column.",
+        };
+  }
+
+  const queriesOnly = queriesResponse.safeParse(json);
+  if (queriesOnly.success) {
+    return {
+      ok: true,
+      value: {
+        siteUrl: queriesOnly.data.SiteUrl ?? null,
+        queries: queriesOnly.data.Queries.map(toQuery),
+        pages: [],
+        reportedQueryTotal: queriesOnly.data.TotalNumOfRecords ?? null,
+      },
+    };
+  }
+
+  const pagesOnly = pagesResponse.safeParse(json);
+  if (pagesOnly.success) {
+    return {
+      ok: true,
+      value: {
+        siteUrl: pagesOnly.data.SiteUrl ?? null,
+        queries: [],
+        pages: pagesOnly.data.Pages.map(toPage),
+        reportedQueryTotal: null,
+      },
+    };
+  }
+
+  const combined = combinedExport.safeParse(json);
+  if (combined.success && (combined.data.queries ?? combined.data.pages)) {
+    return {
+      ok: true,
+      value: {
+        siteUrl: combined.data.site ?? null,
+        queries: (combined.data.queries ?? []).map(toQuery),
+        pages: (combined.data.pages ?? []).map(toPage),
+        reportedQueryTotal: null,
+      },
+    };
+  }
+
+  return {
+    ok: false,
+    error:
+      "No Bing AI Performance rows found. Paste the response from the grounding-queries or pages endpoint, or the combined export.",
+  };
+}
