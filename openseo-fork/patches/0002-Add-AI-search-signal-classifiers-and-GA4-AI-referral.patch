+/**
+ * Hosts that send traffic when someone follows a link out of an AI assistant.
+ *
+ * Unlike the Search Console query fingerprints in `ai-query-signals.ts`, this
+ * is measured rather than inferred: GA4 records the referring host, so a
+ * session attributed here really did arrive from that assistant.
+ *
+ * It still undercounts. Assistants that open links without a referrer — the
+ * ChatGPT desktop and mobile apps among them — land in Direct and cannot be
+ * separated from any other direct visit. Treat the numbers as a floor, and
+ * say so wherever they are shown.
+ *
+ * Engines that AI Visibility already tracks reuse its `AiEngine` ids so both
+ * features can share labels and icons. Assistants it does not track get their
+ * own ids here.
+ */
+
+import type { AiEngine } from "@/shared/ai-visibility";
+
+/** Assistants with no AI Visibility tracker of their own. */
+export type ExtraAiReferrerEngine = "copilot" | "other_ai";
+
+export type AiReferrerEngine = AiEngine | ExtraAiReferrerEngine;
+
+export const AI_REFERRER_ENGINE_LABELS: Record<ExtraAiReferrerEngine, string> =
+  {
+    copilot: "Microsoft Copilot",
+    other_ai: "Other AI assistants",
+  };
+
+interface AiReferrerRule {
+  engine: AiReferrerEngine;
+  /** Matched against the GA4 `sessionSource` value, case-insensitively. */
+  hosts: readonly string[];
+}
+
+/**
+ * Order matters only for readability; hosts are distinct, so at most one rule
+ * matches a given source.
+ */
+export const AI_REFERRER_RULES: readonly AiReferrerRule[] = [
+  { engine: "chatgpt", hosts: ["chatgpt.com", "chat.openai.com", "openai.com"] },
+  { engine: "perplexity", hosts: ["perplexity.ai"] },
+  { engine: "claude", hosts: ["claude.ai", "anthropic.com"] },
+  { engine: "gemini", hosts: ["gemini.google.com", "bard.google.com"] },
+  { engine: "copilot", hosts: ["copilot.microsoft.com", "m365.cloud.microsoft"] },
+  {
+    engine: "other_ai",
+    hosts: [
+      "you.com",
+      "phind.com",
+      "chat.mistral.ai",
+      "meta.ai",
+      "deepseek.com",
+      "grok.com",
+      "x.ai",
+      "duck.ai",
+    ],
+  },
+] as const;
+
+const escapeHost = (host: string) => host.replace(/\./g, "\\.");
+
+/**
+ * Single RE2 alternation for the GA4 `sessionSource` dimension filter, so the
+ * property returns only assistant traffic instead of every source it has.
+ */
+export const AI_REFERRER_SOURCE_REGEX = AI_REFERRER_RULES.flatMap((rule) =>
+  rule.hosts.map(escapeHost),
+).join("|");
+
+/**
+ * Maps a GA4 `sessionSource` to an engine, or null when it is not an
+ * assistant. GA4 reports the bare host, but a source can carry a path or
+ * subdomain, so matching is by substring rather than equality.
+ */
+export function classifyReferrerSource(
+  source: string,
+): AiReferrerEngine | null {
+  const normalized = source.trim().toLowerCase();
+  if (normalized === "") return null;
+  const rule = AI_REFERRER_RULES.find((candidate) =>
+    candidate.hosts.some((host) => normalized.includes(host)),
+  );
+  return rule?.engine ?? null;
+}
