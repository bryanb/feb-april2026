+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { makeGa4Connection } from "./ga4-test-fixtures";
+import { Ga4AiReferralService } from "./Ga4AiReferralService";
+
+const mocks = vi.hoisted(() => ({
+  getByProjectId: vi.fn(),
+  runReport: vi.fn(),
+}));
+
+vi.mock("@/server/features/ga4/repositories/Ga4ConnectionRepository", () => ({
+  Ga4ConnectionRepository: { getByProjectId: mocks.getByProjectId },
+}));
+
+vi.mock("@/server/lib/ga4Client", () => ({
+  createGa4DataClient: () => ({ runReport: mocks.runReport }),
+}));
+
+const metricHeaders = [
+  "sessions",
+  "activeUsers",
+  "engagedSessions",
+  "engagementRate",
+  "keyEvents",
+].map((name) => ({ name }));
+
+/** Two ChatGPT hosts plus one Perplexity, so the rollup has something to fold. */
+const sourceRows = [
+  ["chatgpt.com", "referral", "60", "50", "30", "0.5", "3"],
+  ["chat.openai.com", "referral", "20", "18", "10", "0.5", "1"],
+  ["perplexity.ai", "referral", "20", "20", "20", "1", "2"],
+].map((values) => ({
+  dimensionValues: values.slice(0, 2).map((value) => ({ value })),
+  metricValues: values.slice(2).map((value) => ({ value })),
+}));
+
+/**
+ * The normalizer requires headers to match the request's dimensions exactly,
+ * and only exempts a response that carries no headers at all.
+ */
+const emptyReport = { rows: [], rowCount: 0 };
+
+describe("Ga4AiReferralService", () => {
+  beforeEach(() => {
+    mocks.getByProjectId.mockResolvedValue(makeGa4Connection());
+    mocks.runReport.mockResolvedValue(emptyReport);
+  });
+
+  it("folds hosts of the same assistant into one engine row", async () => {
+    // ChatGPT reaches GA4 under more than one host. Reporting them apart
+    // would understate the assistant that matters most to the user.
+    mocks.runReport.mockResolvedValueOnce({
+      dimensionHeaders: [{ name: "sessionSource" }, { name: "sessionMedium" }],
+      metricHeaders,
+      rows: sourceRows,
+      rowCount: 3,
+    });
+
+    const result = await Ga4AiReferralService.getAiReferrals({
+      projectId: "p1",
+    });
+
+    expect(result?.byEngine).toEqual([
+      {
+        engine: "chatgpt",
+        sessions: 80,
+        activeUsers: 68,
+        engagedSessions: 40,
+        keyEvents: 4,
+        engagementRate: 0.5,
+      },
+      {
+        engine: "perplexity",
+        sessions: 20,
+        activeUsers: 20,
+        engagedSessions: 20,
+        keyEvents: 2,
+        engagementRate: 1,
+      },
+    ]);
+  });
+
+  it("filters at Google on the assistant source list", async () => {
+    // Fetching every source and filtering locally would page through
+    // thousands of rows before finding the few that matter.
+    await Ga4AiReferralService.getAiReferrals({ projectId: "p1" });
+
+    const [request] = mocks.runReport.mock.calls[0] ?? [];
+    expect(request.dimensionFilter.filter).toMatchObject({
+      fieldName: "sessionSource",
+      stringFilter: { matchType: "PARTIAL_REGEXP", caseSensitive: false },
+    });
+  });
+});
diff --git a/src/server/features/ga4/services/Ga4AiReferralService.ts b/src/server/features/ga4/services/Ga4AiReferralService.ts
new file mode 100644
index 00000000..f55f3004
--- /dev/null
+++ b/src/server/features/ga4/services/Ga4AiReferralService.ts
@@ -0,0 +1,253 @@
+/**
+ * Sessions that arrived from an AI assistant, read from GA4.
+ *
+ * This is the measured half of AI search visibility: GA4 recorded the
+ * referring host, so these sessions really did come from the assistant named.
+ * The inferred half lives in the Search Console query fingerprints
+ * (`src/shared/ai-query-signals.ts`).
+ *
+ * The figures are a floor, not a total. Assistants that open links without a
+ * referrer — the ChatGPT apps among them — are indistinguishable from Direct,
+ * so every surface showing these numbers must say they undercount.
+ *
+ * Filtering happens at Google rather than over fetched rows: a property with
+ * thousands of sources would otherwise need paging before the handful of
+ * assistant rows could be found.
+ */
+
+import { Ga4ConnectionRepository } from "@/server/features/ga4/repositories/Ga4ConnectionRepository";
+import { createGa4DataClient } from "@/server/lib/ga4Client";
+import type { Ga4RunReportRequest } from "@/server/lib/ga4Client";
+import { Ga4ReportError } from "@/server/lib/ga4Errors";
+import {
+  AI_REFERRER_SOURCE_REGEX,
+  classifyReferrerSource,
+  type AiReferrerEngine,
+} from "@/shared/ai-referrers";
+import { normalizeGa4Response } from "./Ga4ReportNormalization";
+import { previousPeriod } from "./Ga4ReportEnhancements";
+import { mapGa4ReportError, resolveGa4DateRange } from "./Ga4ReportingService";
+
+const REFERRAL_METRICS = [
+  "sessions",
+  "activeUsers",
+  "engagedSessions",
+  "engagementRate",
+  "keyEvents",
+] as const;
+
+type Ga4AiReferralInput = {
+  projectId: string;
+  startDate?: string;
+  endDate?: string;
+};
+
+type Ga4Row = Record<string, string | number | null>;
+
+function aiSourceFilter() {
+  return {
+    filter: {
+      fieldName: "sessionSource",
+      stringFilter: {
+        matchType: "PARTIAL_REGEXP",
+        value: AI_REFERRER_SOURCE_REGEX,
+        caseSensitive: false,
+      },
+    },
+  };
+}
+
+function buildReferralRequest(input: {
+  startDate: string;
+  endDate: string;
+  dimensions: readonly string[];
+  orderMetric?: string;
+  limit?: number;
+}): Ga4RunReportRequest {
+  const [firstDimension] = input.dimensions;
+  return {
+    dateRanges: [{ startDate: input.startDate, endDate: input.endDate }],
+    dimensions: input.dimensions.map((name) => ({ name })),
+    metrics: REFERRAL_METRICS.map((name) => ({ name })),
+    dimensionFilter: aiSourceFilter(),
+    offset: "0",
+    limit: String(input.limit ?? 1000),
+    orderBys: input.orderMetric
+      ? [{ metric: { metricName: input.orderMetric }, desc: true }]
+      : firstDimension
+        ? [{ dimension: { dimensionName: firstDimension } }]
+        : [],
+    keepEmptyRows: false,
+    returnPropertyQuota: true,
+  };
+}
+
+const numeric = (row: Ga4Row, key: string) =>
+  typeof row[key] === "number" ? row[key] : 0;
+
+/**
+ * Rolls per-source rows up to one row per assistant. Engagement rate is a
+ * ratio, so it is recomputed from engaged sessions rather than summed.
+ */
+function rollUpByEngine(rows: Ga4Row[]) {
+  const totals = new Map<
+    AiReferrerEngine,
+    { sessions: number; activeUsers: number; engagedSessions: number; keyEvents: number }
+  >();
+  for (const row of rows) {
+    const engine = row.engine as AiReferrerEngine | null;
+    if (!engine) continue;
+    const current = totals.get(engine) ?? {
+      sessions: 0,
+      activeUsers: 0,
+      engagedSessions: 0,
+      keyEvents: 0,
+    };
+    totals.set(engine, {
+      sessions: current.sessions + numeric(row, "sessions"),
+      activeUsers: current.activeUsers + numeric(row, "activeUsers"),
+      engagedSessions: current.engagedSessions + numeric(row, "engagedSessions"),
+      keyEvents: current.keyEvents + numeric(row, "keyEvents"),
+    });
+  }
+  return [...totals.entries()]
+    .map(([engine, value]) => ({
+      engine,
+      ...value,
+      engagementRate:
+        value.sessions === 0 ? null : value.engagedSessions / value.sessions,
+    }))
+    .sort((a, b) => b.sessions - a.sessions);
+}
+
+function annotateSources(rows: Ga4Row[]) {
+  return rows.map((row) => ({
+    ...row,
+    engine: classifyReferrerSource(String(row.sessionSource ?? "")),
+  }));
+}
+
+function sumSessions(rows: Ga4Row[]) {
+  return rows.reduce((total, row) => total + numeric(row, "sessions"), 0);
+}
+
+async function getAiReferrals(
+  input: Ga4AiReferralInput,
+  opts: { now?: Date } = {},
+) {
+  const connection = await Ga4ConnectionRepository.getByProjectId(
+    input.projectId,
+  );
+  if (!connection) {
+    throw new Ga4ReportError(
+      "ga4_not_connected",
+      "Google Analytics is not connected for this project.",
+    );
+  }
+  const dateRange = resolveGa4DateRange(
+    input,
+    connection.propertyTimeZone,
+    opts.now,
+  );
+  const resolved = dateRange.resolvedDateRange;
+  const previousDateRange = previousPeriod(resolved);
+
+  const sourceRequest = buildReferralRequest({
+    ...resolved,
+    dimensions: ["sessionSource", "sessionMedium"],
+    orderMetric: "sessions",
+  });
+  const previousRequest = buildReferralRequest({
+    ...previousDateRange,
+    dimensions: ["sessionSource", "sessionMedium"],
+    orderMetric: "sessions",
+  });
+  const trendRequest = buildReferralRequest({
+    ...resolved,
+    dimensions: ["date"],
+  });
+  const landingPageRequest = buildReferralRequest({
+    ...resolved,
+    dimensions: ["hostName", "landingPage"],
+    orderMetric: "sessions",
+    limit: 250,
+  });
+
+  const client = createGa4DataClient({
+    userId: connection.connectedByUserId,
+    ga4AccountId: connection.ga4AccountId,
+    propertyId: connection.propertyId,
+  });
+
+  try {
+    const [sourceResponse, previousResponse, trendResponse, landingResponse] =
+      await Promise.all([
+        client.runReport(sourceRequest),
+        client.runReport(previousRequest),
+        client.runReport(trendRequest),
+        client.runReport(landingPageRequest),
+      ]);
+    const sources = normalizeGa4Response(sourceResponse, sourceRequest);
+    const previous = normalizeGa4Response(previousResponse, previousRequest);
+    const trend = normalizeGa4Response(trendResponse, trendRequest);
+    const landingPages = normalizeGa4Response(
+      landingResponse,
+      landingPageRequest,
+    );
+    const reports = [sources, previous, trend, landingPages];
+    const bySource = annotateSources(sources.rows);
+    const currentSessions = sumSessions(sources.rows);
+    const previousSessions = sumSessions(previous.rows);
+    return {
+      status: "ok" as const,
+      source: {
+        provider: "google_analytics" as const,
+        propertyId: connection.propertyId,
+        propertyDisplayName: connection.propertyDisplayName,
+      },
+      request: {
+        requestedDateRange: dateRange.requestedDateRange,
+        resolvedDateRange: resolved,
+        previousDateRange,
+        propertyTimeZone: connection.propertyTimeZone,
+      },
+      totals: {
+        sessions: currentSessions,
+        previousSessions,
+        keyEvents: sources.rows.reduce(
+          (total, row) => total + numeric(row, "keyEvents"),
+          0,
+        ),
+      },
+      byEngine: rollUpByEngine(bySource),
+      bySource,
+      landingPages: landingPages.rows,
+      trend: trend.rows,
+      /**
+       * Stated on every surface: assistants that strip the referrer are
+       * counted as Direct and cannot be recovered from this report.
+       */
+      measurement: {
+        basis: "ga4_session_source" as const,
+        undercounts: true,
+      },
+      reportMetadata: {
+        hasLimitedData: reports.some(
+          (report) => report.reportMetadata.hasLimitedData,
+        ),
+        reports: reports.map((report) => report.reportMetadata),
+      },
+      quota: sources.quota ?? trend.quota,
+      warnings: [
+        ...dateRange.warnings,
+        ...(sources.totalRowCount > sources.rows.length
+          ? ["sources_truncated"]
+          : []),
+      ],
+    };
+  } catch (error) {
+    mapGa4ReportError(error);
+  }
+}
+
+export const Ga4AiReferralService = { getAiReferrals };
