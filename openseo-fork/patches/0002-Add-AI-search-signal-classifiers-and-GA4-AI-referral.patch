+import { describe, expect, it } from "vitest";
+import {
+  AI_QUERY_PRESETS,
+  AI_QUERY_SIGNALS,
+  classifyQuery,
+  normalizeMachineQuery,
+} from "@/shared/ai-query-signals";
+
+describe("AI_QUERY_SIGNALS", () => {
+  it("compiles every pattern as a JS RegExp", () => {
+    // The same source string is sent to Google as RE2 and run locally as a
+    // JS RegExp. A pattern that only one engine accepts would make the local
+    // verdict disagree with the rows Google returned.
+    for (const signal of AI_QUERY_SIGNALS) {
+      expect(() => new RegExp(signal.pattern)).not.toThrow();
+    }
+  });
+});
+
+describe("classifyQuery", () => {
+  it.each([
+    ['"best cnc machining shop in chicago"', "quoted"],
+    ["**precision grinding** services", "markdown-emphasis"],
+    ["[swiss machining](https://example.com/swiss)", "markdown-link"],
+    ["- surface grinding tolerances", "markdown-block"],
+    ["swiss screw machining site:example.com", "search-operator"],
+    ["edm machining -hobbyist", "exclusion"],
+  ])("flags %s as likely machine-issued", (query, expectedSignal) => {
+    const result = classifyQuery(query);
+    expect(result.verdict).toBe("likely_machine");
+    expect(result.signalIds).toContain(expectedSignal);
+  });
+
+  it.each([
+    "cnc machining services milwaukee",
+    "5-axis aerospace parts manufacturer wisconsin",
+    "what is the tightest tolerance for surface grinding",
+    "iso 9001 certified precision machine shop near me",
+  ])("leaves ordinary search %s unflagged", (query) => {
+    // These are the queries the agency actually ranks for. A false positive
+    // here would quietly inflate every number on the page, including the
+    // long conversational one — length must not drive the verdict.
+    expect(classifyQuery(query).verdict).toBe("none");
+  });
+
+  it("rates a bare conversational reply only as possible", () => {
+    // AI Mode logs follow-ups as new searches, but "yes" is also a plausible
+    // human query, so it must not count as high confidence.
+    expect(classifyQuery("yes").verdict).toBe("possible");
+  });
+});
+
+describe("AI_QUERY_PRESETS", () => {
+  it("matches the same queries Google would return for the combined preset", () => {
+    const preset = new RegExp(AI_QUERY_PRESETS.any, "i");
+    expect(preset.test('"deburring services"')).toBe(true);
+    expect(preset.test("cnc machining services milwaukee")).toBe(false);
+  });
+});
+
+describe("normalizeMachineQuery", () => {
+  it("strips machine syntax and keeps the wording", () => {
+    // The wording is the part worth tracking as an AI Visibility prompt.
+    expect(
+      normalizeMachineQuery('"best **swiss** machining shop" site:example.com'),
+    ).toBe("best swiss machining shop");
+  });
+});
diff --git a/src/shared/ai-query-signals.ts b/src/shared/ai-query-signals.ts
new file mode 100644
index 00000000..7cdb526a
--- /dev/null
+++ b/src/shared/ai-query-signals.ts
@@ -0,0 +1,175 @@
+/**
+ * Fingerprints for Search Console queries that look machine-issued.
+ *
+ * Google does not label AI traffic: the Search Analytics API exposes no AI
+ * search type and no AI `searchAppearance`, and the Generative AI performance
+ * report is UI-only with no query detail. The only signal left is the query
+ * text itself, and the strongest one is syntax a person would not type —
+ * exact-match quotes, markdown, and search operators — which assistants emit
+ * when they search on someone's behalf.
+ *
+ * This is inference, not measurement. Every surface built on it must say so.
+ *
+ * Word count is deliberately not scored. Assistant-issued queries are often
+ * short (AI Mode turns conversational follow-ups like "yes" into fresh
+ * searches), so length both misses real cases and catches ordinary long-tail.
+ * It is exposed for display only.
+ *
+ * Every pattern here is sent to Google as RE2 *and* run locally as a JS
+ * `RegExp`, so all of them stay inside the shared subset of both: no
+ * lookaround, no backreferences, no inline flags. `ai-query-signals.test.ts`
+ * enforces that.
+ */
+
+/** How much weight to give a match when describing it to a user. */
+export type AiQuerySignalTier = "likely_machine" | "possible";
+
+export type AiQueryVerdict = AiQuerySignalTier | "none";
+
+export interface AiQuerySignal {
+  id: string;
+  /** Short column/badge label. */
+  label: string;
+  /** Why this shape suggests a machine issued the query. */
+  description: string;
+  /** Pattern source, valid in both RE2 and JS. Matched case-insensitively. */
+  pattern: string;
+  tier: AiQuerySignalTier;
+}
+
+export const AI_QUERY_SIGNALS: readonly AiQuerySignal[] = [
+  {
+    id: "quoted",
+    label: "Quoted",
+    description:
+      'Wrapped in quotation marks for an exact-match search. Assistants quote a phrase to pin it down; people rarely type quotes.',
+    pattern: '["“”„]',
+    tier: "likely_machine",
+  },
+  {
+    id: "markdown-emphasis",
+    label: "Markdown",
+    description:
+      "Contains markdown bold or code formatting, which leaks from a model's own output into the query string.",
+    pattern: "\\*\\*|`",
+    tier: "likely_machine",
+  },
+  {
+    id: "markdown-link",
+    label: "Markdown link",
+    description:
+      "Contains markdown link syntax, which only appears when generated text is pasted into a search.",
+    pattern: "\\[[^\\]]+\\]\\([^)]*\\)",
+    tier: "likely_machine",
+  },
+  {
+    id: "markdown-block",
+    label: "Markdown block",
+    description:
+      "Starts with a markdown heading or list marker — a fragment of formatted output, not something typed into a search box.",
+    pattern: "^(#+ |[-*+] )",
+    tier: "likely_machine",
+  },
+  {
+    id: "search-operator",
+    label: "Operator",
+    description:
+      "Uses a Google search operator such as site: or filetype:. Assistants use operators to scope a search; most people never do.",
+    pattern: "(^| )-?(site|intitle|inurl|filetype|allintitle|allinurl):",
+    tier: "likely_machine",
+  },
+  {
+    id: "exclusion",
+    label: "Exclusion",
+    description:
+      "Excludes a term with a leading minus, a refinement assistants add when narrowing results.",
+    pattern: "(^| )-[a-z0-9]",
+    tier: "likely_machine",
+  },
+  {
+    id: "conversational-fragment",
+    label: "Fragment",
+    description:
+      "A bare conversational reply. AI Mode treats follow-ups in a conversation as new searches, so these surface as queries.",
+    pattern:
+      "^(yes|no|ok|okay|sure|go on|continue|tell me more|more details|thanks|thank you)( |$)",
+    tier: "possible",
+  },
+] as const;
+
+const signalRegex = (signal: AiQuerySignal) => new RegExp(signal.pattern, "i");
+
+export interface AiQueryClassification {
+  /** Ids of every signal the query matched, in registry order. */
+  signalIds: string[];
+  /**
+   * `likely_machine` when any high-confidence signal matched, `possible` when
+   * only a weaker one did, `none` when the query looks human.
+   */
+  verdict: AiQueryVerdict;
+  /** Display only — never used to decide the verdict. */
+  wordCount: number;
+}
+
+export function classifyQuery(query: string): AiQueryClassification {
+  const matched = AI_QUERY_SIGNALS.filter((signal) =>
+    signalRegex(signal).test(query),
+  );
+  const verdict: AiQueryVerdict = matched.some(
+    (signal) => signal.tier === "likely_machine",
+  )
+    ? "likely_machine"
+    : matched.length > 0
+      ? "possible"
+      : "none";
+  return {
+    signalIds: matched.map((signal) => signal.id),
+    verdict,
+    wordCount: countWords(query),
+  };
+}
+
+export function countWords(query: string): number {
+  const trimmed = query.trim();
+  return trimmed === "" ? 0 : trimmed.split(/\s+/).length;
+}
+
+/**
+ * Ready-to-send RE2 expressions for the Search Console `includingRegex`
+ * filter, so Google does the matching and only machine-shaped rows come back.
+ */
+export const AI_QUERY_PRESETS = {
+  any: buildPreset(AI_QUERY_SIGNALS.map((signal) => signal.id)),
+  quoted: buildPreset(["quoted"]),
+  markdown: buildPreset([
+    "markdown-emphasis",
+    "markdown-link",
+    "markdown-block",
+  ]),
+  operators: buildPreset(["search-operator", "exclusion"]),
+  fragments: buildPreset(["conversational-fragment"]),
+} as const;
+
+export type AiQueryPresetId = keyof typeof AI_QUERY_PRESETS;
+
+function buildPreset(signalIds: readonly string[]): string {
+  return AI_QUERY_SIGNALS.filter((signal) => signalIds.includes(signal.id))
+    .map((signal) => `(${signal.pattern})`)
+    .join("|");
+}
+
+/**
+ * Strips machine syntax so a detected query can seed an AI Visibility prompt.
+ * Only formatting is removed; the wording is left exactly as issued, because
+ * that wording is the thing worth tracking.
+ */
+export function normalizeMachineQuery(query: string): string {
+  return query
+    .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
+    .replace(/[*`]+/g, "")
+    .replace(/["“”„]/g, "")
+    .replace(/(^| )-?(site|intitle|inurl|filetype|allintitle|allinurl):\S*/gi, " ")
+    .replace(/^(#+|[-*+])\s+/, "")
+    .replace(/\s+/g, " ")
+    .trim();
+}
