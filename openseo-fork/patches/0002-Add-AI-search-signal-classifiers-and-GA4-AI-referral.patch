+import { describe, expect, it } from "vitest";
+import {
+  AI_REFERRER_SOURCE_REGEX,
+  classifyReferrerSource,
+} from "@/shared/ai-referrers";
+
+describe("classifyReferrerSource", () => {
+  it.each([
+    ["chatgpt.com", "chatgpt"],
+    ["perplexity.ai", "perplexity"],
+    ["claude.ai", "claude"],
+    ["gemini.google.com", "gemini"],
+    ["copilot.microsoft.com", "copilot"],
+    ["you.com", "other_ai"],
+  ])("maps %s to %s", (source, engine) => {
+    expect(classifyReferrerSource(source)).toBe(engine);
+  });
+
+  it.each(["google", "bing", "(direct)", "linkedin.com", "thomasnet.com"])(
+    "returns null for ordinary source %s",
+    (source) => {
+      // "google" must not be mistaken for gemini.google.com — organic search
+      // is the baseline these numbers get compared against.
+      expect(classifyReferrerSource(source)).toBeNull();
+    },
+  );
+});
+
+describe("AI_REFERRER_SOURCE_REGEX", () => {
+  it("matches the same sources GA4 would filter to", () => {
+    // GA4 applies this as RE2; the local classifier decides the engine. If
+    // they disagreed, rows would arrive that the classifier drops silently.
+    const filter = new RegExp(AI_REFERRER_SOURCE_REGEX, "i");
+    expect(filter.test("chatgpt.com")).toBe(true);
+    expect(filter.test("google")).toBe(false);
+  });
+});
